      value: 
      objectReference: {fileID: 953916463}
    - target: {fileID: 6703398087511372979, guid: 3a47aadbccb3231498296dce44a862f2, type: 3}
      propertyPath: lines.Array.size
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 6703398087511372979, guid: 3a47aadbccb3231498296dce44a862f2, type: 3}
      propertyPath: 'lines.Array.data[0]'
      value: 'Commissioner Harold: Detective Rose, good morning.

'
      objectReference: {fileID: 0}
    - target: {fileID: 6703398087511372979, guid: 3a47aadbccb3231498296dce44a862f2, type: 3}
      propertyPath: 'lines.Array.data[1]'
      value: 'Rose: good morning to you commissioner Harold'
      objectReference: {fileID: 0}
    - target: {fileID: 6703398087511372979, guid: 3a47aadbccb3231498296dce44a862f2, type: 3}
      propertyPath: 'lines.Array.data[2]'
      value: 'Commissioner Harold: As you may have heard, we found Pisces'' body
        this morning in the woods off of Lake Road. We found very little evidence
        at the scene.

'
      objectReference: {fileID: 0}
    - target: {fileID: 6703398087511372979, guid: 3a47aadbccb3231498296dce44a862f2, type: 3}
      propertyPath: 'lines.Array.data[3]'
      value: 'Rose: Thats why you need me.

'
      objectReference: {fileID: 0}
    - target: {fileID: 6703398087511372979, guid: 3a47aadbccb3231498296dce44a862f2, type: 3}
      propertyPath: 'lines.Array.data[4]'
      value: 'Commissioner: I''m glad you understand. We need you to use DeepDive
        to analyze what remains of her brain to recreate the crime scene. An autopsy
        report to determine the cause of death. I will inform you when that is ready.
        Turn off the light and step into the machine to begin



'
      objectReference: {fileID: 0}
